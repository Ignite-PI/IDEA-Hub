# Copy to ".env" for local use. On Vercel set these in Project → Settings → Environment Variables.
# ".env" is git-ignored and never uploaded. Never put these values in frontend code.

# ── Sign-in (required) ───────────────────────────────────────────────────────
# Generate with:  node scripts/hash-password.cjs   (prints a new password, its hash and a secret)
AUTH_USERNAME=IGNITE
AUTH_PASSWORD_HASH=
AUTH_SECRET=
# AUTH_SESSION_HOURS=12

# ── Database ─────────────────────────────────────────────────────────────────
# Production: Postgres (Neon via Vercel Storage sets DATABASE_URL automatically).
# DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Local options: DATA_PROVIDER=sqlite (default without DATABASE_URL) or DATA_PROVIDER=pglite with PGLITE_DIR=.pglite

# ── Azure OpenAI Service (optional AI writing assistant) ─────────────────────
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=<deployment-name>
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21
# AI_ENABLED=false
# AI_MAX_REQUESTS_PER_MINUTE=20
# AI_TIMEOUT_MS=25000

# ── Local server ─────────────────────────────────────────────────────────────
# PORT=3002
# SBF_DB_PATH=C:\path\to\sbf_tower.sqlite
